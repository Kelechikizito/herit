# World ID — Developer Portal
NEXT_PUBLIC_WLD_APP_ID=
NEXT_PUBLIC_WLD_ENVIRONMENT=staging
WLD_RP_ID=

# Server only. Never prefix these NEXT_PUBLIC_, never log them.
RP_SIGNING_KEY=
NULLIFIER_SALT=
ATTESTOR_PRIVATE_KEY=

# Sepolia
NEXT_PUBLIC_CHAIN_ID=11155111
# Read by wagmi and by the verify route's pre-checks. Unset falls back to the public RPC, which rate-limits.
NEXT_PUBLIC_SEPOLIA_RPC_URL=

# The Graph — the herit subgraph's query URL from Subgraph Studio. Unset leaves the dashboard's
# activity feed disconnected. The deploy key is not an env var: it is used once, by `graph auth`.
NEXT_PUBLIC_SUBGRAPH_URL=
